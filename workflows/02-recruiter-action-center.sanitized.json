              "type": "string"
            },
            {
              "id": "5fc3289c-4df2-477b-8dd7-6aee797115ed",
              "name": "transition_allowed",
              "value": "={{\n(() => {\n  const current = $json.stage;\n  const target = $('02 - Normalize Recruiter Action').item.json.target_stage;\n\n  const allowedTransitions = {\n    'New Applicant': [\n      'Shortlisted',\n      'Interview Scheduled',\n      'Assessment',\n      'Rejected',\n      'On Hold',\n      'Closed'\n    ],\n    'Shortlisted': [\n      'Interview Scheduled',\n      'Assessment',\n      'Rejected',\n      'On Hold',\n      'Closed'\n    ],\n    'Interview Scheduled': [\n      'Assessment',\n      'Offer',\n      'Rejected',\n      'On Hold',\n      'Closed'\n    ],\n    'Assessment': [\n      'Interview Scheduled',\n      'Offer',\n      'Rejected',\n      'On Hold',\n      'Closed'\n    ],\n    'Offer': [\n      'Hired',\n      'Closed'\n    ],\n    'On Hold': [\n      'Shortlisted',\n      'Interview Scheduled',\n      'Assessment',\n      'Offer',\n      'Rejected',\n      'Closed'\n    ]\n  };\n\n  return (allowedTransitions[current] || []).includes(target);\n})()\n}}",
              "type": "boolean"
            },
            {
              "id": "44b36afd-b638-476a-94cc-d30e53e9b15c",
              "name": "validation_message",
              "value": "={{\n(() => {\n  const current = $json.stage;\n  const target = $('02 - Normalize Recruiter Action').item.json.target_stage;\n  const action = $('02 - Normalize Recruiter Action').item.json.recruiter_action;\n\n  const allowedTransitions = {\n    'New Applicant': [\n      'Shortlisted',\n      'Interview Scheduled',\n      'Assessment',\n      'Rejected',\n      'On Hold',\n      'Closed'\n    ],\n    'Shortlisted': [\n      'Interview Scheduled',\n      'Assessment',\n      'Rejected',\n      'On Hold',\n      'Closed'\n    ],\n    'Interview Scheduled': [\n      'Assessment',\n      'Offer',\n      'Rejected',\n      'On Hold',\n      'Closed'\n    ],\n    'Assessment': [\n      'Interview Scheduled',\n      'Offer',\n      'Rejected',\n      'On Hold',\n      'Closed'\n    ],\n    'Offer': [\n      'Hired',\n      'Closed'\n    ],\n    'On Hold': [\n      'Shortlisted',\n      'Interview Scheduled',\n      'Assessment',\n      'Offer',\n      'Rejected',\n      'Closed'\n    ]\n  };\n\n  return (allowedTransitions[current] || []).includes(target)\n    ? `Stage transition allowed: ${current} → ${target}.`\n    : `Stage transition blocked: ${current} → ${target} via recruiter action \"${action}\".`;\n})()\n}}",
              "type": "string"
            }
          ]
        },
