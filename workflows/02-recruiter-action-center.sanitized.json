      "name": "13 - Prepare Candidate Communication"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=\n{{\n`Write a professional recruitment email draft based only on the information below.\n\nThis email will be reviewed by a recruiter before sending.\n\nRules:\n- Do not invent details.\n- Keep the tone professional, concise, and friendly.\n- Address the candidate by name.\n- Mention the job title.\n- Follow the recruiter action exactly.\n- If an interview date/time is provided, include it clearly.\n- Do not claim that the email has already been sent.\n- Do not add information that is not provided.\n- Do not include a subject line.\n- Do not promise future actions, additional details, links, or instructions unless they are explicitly provided in the recruiter notes or input data.\n- Return only the email body.\n- Sign the email using the recruiter's name.\n- Never promise future actions, follow-up messages, additional interview details, links, documents, or instructions unless they are explicitly provided in the recruiter notes or input data.\n- If information is not provided, simply omit it instead of assuming what will happen next.\n\nCandidate Name: ${$json.candidate_name}\nJob Title: ${$json.job_title}\nRecruiter Action: ${$json.recruiter_action}\nRecruiter Notes: ${$json.recruiter_notes}\nInterview Date/Time: ${$json.interview_datetime || 'Not provided'}\nNext Action Date: ${$json.next_action_date || 'Not provided'}\nRecruiter Name: ${$json.recruiter_name}`\n}}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        2688,
        -288
      ],
