                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        -192
      ],
      "id": "7ba90e96-5977-4b85-98c5-c36361e58096",
      "name": "03 - Is Active Application?"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "7e0a4d45-4ec1-49c6-940b-f54d5c6d4429",
              "leftValue": "={{   $json.next_action_date   &&   DateTime.fromISO($json.next_action_date).startOf('day')     <= $now.startOf('day') }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
