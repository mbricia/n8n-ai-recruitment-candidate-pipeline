    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "be88d09d-fb0c-4885-b139-998fa30a43f6",
              "leftValue": "={{ !['Rejected', 'Withdrawn', 'Hired', 'Closed'].includes($json.stage) }}",
              "rightValue": "",
