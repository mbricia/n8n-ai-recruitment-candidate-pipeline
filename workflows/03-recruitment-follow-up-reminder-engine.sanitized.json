        672,
        -192
      ],
      "id": "074f400a-7ed9-4061-9ea9-96d7e4a7ea38",
      "name": "04 - Follow-up Due?"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9ad78a9d-874d-45e5-a972-df2c520bdaac",
              "name": "application_id",
              "value": "={{ $json.application_id }}",
              "type": "string"
            },
            {
              "id": "c0431e8f-7a6d-42d4-ab30-2e504ab1e2e1",
              "name": "candidate_id",
              "value": "={{ $json.candidate_id }}",
              "type": "string"
            },
            {
              "id": "13909b91-19b4-4c4c-abc5-4bd125ec8639",
              "name": "job_title",
              "value": "={{ $json.job_title }}",
              "type": "string"
            },
            {
              "id": "49a2a0ef-a39a-409c-ae3c-158f59e54495",
              "name": "stage",
              "value": "={{ $json.stage }}",
              "type": "string"
            },
            {
              "id": "ef31ec4a-e741-4e18-885f-97f190b8e096",
              "name": "recruiter_name",
              "value": "={{ $json.recruiter_name }}",
              "type": "string"
            },
            {
              "id": "3dbf8494-a070-4d68-b4c9-e4bbb32a33de",
              "name": "recruiter_email",
              "value": "={{ $json.recruiter_email }}",
              "type": "string"
            },
            {
              "id": "d0cc0282-0afa-4b2b-87d6-b42a25aa8282",
              "name": "next_action_date",
              "value": "={{ $json.next_action_date }}",
              "type": "string"
            },
            {
              "id": "01afe533-8a3c-45e7-87a8-8a9f5b576c5d",
              "name": "days_overdue",
              "value": "={{\n  Math.max(\n    0,\n    Math.floor(\n      $now.startOf('day')\n        .diff(DateTime.fromISO($json.next_action_date).startOf('day'), 'days')\n        .days\n    )\n  )\n}}",
              "type": "number"
            },
            {
              "id": "ff60db29-bd7e-484e-acb0-182a34a4fe02",
              "name": "reminder_subject",
              "value": "={{\n  DateTime.fromISO($json.next_action_date).startOf('day')\n    .equals($now.startOf('day'))\n    ? `Recruitment Action Due Today - ${$json.job_title} (${$json.application_id})`\n    : `Overdue Recruitment Follow-up - ${$json.job_title} (${$json.application_id})`\n}}",
              "type": "string"
            },
            {
              "id": "61e00b51-acda-47e6-86a4-68a4c0a9ccc4",
              "name": "reminder_message",
              "value": "={{\n(() => {\n  const dueDate = DateTime.fromISO($json.next_action_date).startOf('day');\n  const today = $now.startOf('day');\n\n  const daysOverdue = Math.max(\n    0,\n    Math.floor(today.diff(dueDate, 'days').days)\n  );\n\n  const statusMessage = dueDate.equals(today)\n    ? 'This recruitment action is due today.'\n    : `This recruitment action is ${daysOverdue} day(s) overdue.`;\n\n  return `Hi ${$json.recruiter_name},\n\nA recruitment action requires your attention.\n\nApplication ID: ${$json.application_id}\nPosition: ${$json.job_title}\nCurrent Stage: ${$json.stage}\nNext Action Date: ${$json.next_action_date}\n\n${statusMessage}\n\nPlease review the application and update the recruitment pipeline when appropriate.\n\nThis is an automated internal reminder from the Recruitment Pipeline system.`;\n})()\n}}",
              "type": "string"
            },
            {
              "id": "ae847d50-3836-4e10-9d42-1e969f70403d",
              "name": "reminder_key",
              "value": "={{ $json.application_id + '|' + $now.toFormat('yyyy-MM-dd') }}",
              "type": "string"
            },
            {
              "id": "35bd38b8-db23-440b-a01a-01ccd8d32059",
              "name": "reminder_status",
              "value": "={{   DateTime.fromISO($json.next_action_date).startOf('day')     .equals($now.startOf('day'))     ? 'Due Today'     : 'Overdue' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
