      "id": "579d3d3b-80a3-4542-878d-4d280c4e7302",
      "name": "04 - Check Recruitment Email"
    },
    {
      "parameters": {
        "text": "={{\n`You are interpreting an incoming email for a company's recruitment pipeline.\n\nRules:\n- Determine whether this email belongs to an actual candidate/application being managed by the hiring company.\n- Do NOT treat the email recipient, recruiter, HR staff, or hiring manager as the candidate.\n- Candidate information must come from the actual applicant/candidate mentioned or sending the email.\n- Job alerts, expired job notifications, job-board updates sent to a job seeker, marketing emails, and general recruitment content are NOT candidate pipeline emails.\n- Do not invent facts that are not explicitly supported by the email.\n- If the candidate identity is unknown or this is not a candidate pipeline email, return null for candidate_name and candidate_email.\n- If an interview date and time are explicitly provided, extract them as an ISO 8601 datetime.\n- If no interview date and time are explicitly stated, return null for interview_date.\n- Use \"new_application\" only for a new candidate application.\n- Use \"candidate_follow_up\" when the candidate is following up on an existing application without changing the recruitment stage.\n- Use \"interview_related\" for interview invitations, interview confirmations, interview rescheduling, or other interview-specific communication.\n- Use \"assessment_related\" for tests, technical assessments, exams, or take-home tasks.\n- Use \"offer_related\" for job offers or offer-related communication.\n- Use \"withdrawal\" when the candidate withdraws their application.\n- Use \"other_candidate_related\" for relevant candidate communication that does not fit the categories above.\n- Use \"not_candidate_related\" when the email is not part of an actual candidate pipeline.\n- Use \"rejection\" when the hiring company informs the candidate that they will not proceed with the application or that the candidate was not selected.\n\nSUBJECT:\n${$json.subject}\n\nFROM:\n${$json.sender}\n\nEMAIL:\n${$json.email_body}`\n}}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"is_candidate_pipeline_email\": {\n      \"type\": \"boolean\",\n      \"description\": \"True only if this email is directly related to an actual candidate or job application being managed by the hiring company. False for job alerts, job-board notifications sent to job seekers, marketing, expired listing notices, and unrelated recruitment content.\"\n    },\n    \"email_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"new_application\",\n        \"candidate_follow_up\",\n        \"interview_related\",\n        \"assessment_related\",\n        \"offer_related\",\n        \"rejection\",\n        \"withdrawal\",\n        \"other_candidate_related\",\n        \"not_candidate_related\"\n      ]\n    },\n    \"candidate_name\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"Full name of the actual candidate or applicant. Return null if unknown or if the email is not candidate-related.\"\n    },\n    \"candidate_email\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"Email address of the actual candidate or applicant. Return null if unknown or if the email is not candidate-related.\"\n    },\n    \"job_title\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"The position the candidate applied for or is being considered for. Return null if it cannot be determined.\"\n    },\n    \"interview_date\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"Interview date and time in ISO 8601 format when explicitly stated in the email. Return null if no interview schedule is provided.\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"A concise factual summary of the email and any important candidate or recruitment details.\"\n    }\n  },\n  \"required\": [\n    \"is_candidate_pipeline_email\",\n    \"email_type\",\n    \"candidate_name\",\n    \"candidate_email\",\n    \"job_title\",\n    \"interview_date\",\n    \"summary\"\n  ]\n}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        1568,
        -192
      ],
