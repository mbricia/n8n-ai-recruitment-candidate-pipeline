              "leftValue": "={{\n  /\\b(application|applicant|candidate|resume|curriculum vitae|interview|assessment|offer|rejection|rejected|decline|withdrawal|withdraw|shortlisted|screening|hiring)\\b/i\n    .test(($json.subject || '') + ' ' + ($json.email_body || ''))\n}}",
